
ORACLE_USER=DIGITALIZACION
ORACLE_PASSWORD=change_me

ORACLE_JDBC_JAR=jdbc/ojdbc8 copy.jar

ORACLE_TARGETS=172.16.60.20:1521:prdsgh1,172.16.60.21:1521:prdsgh2
ORACLE_TABLE=prueba
ORACLE_ROWS=10
# The ORACLE_USER account used by FastAPI must be authorized to read
# DBA_ROLE_PRIVS and grant/revoke the supported SPD_* roles for /admin/roles.

# Base directory where scripts create folder trees
DIGI_BASE_DIR=datos
# URL used by Control documental to read the independent Redis API
MOTOR_REDIS_API_URL=http://127.0.0.1:8091
MOTOR_REDIS_DASHBOARD_URL=http://172.16.60.127:8091/
# Durable Control documental -> Redis refresh requests in Oracle
CD_REDIS_SYNC_ENABLED=1
ORACLE_CONTROL_DOC_OWNER=DIGITALIZACION
# Filesystem index range (default: current year only)
DIGI_FS_YEAR_FROM=2026
DIGI_FS_YEAR_TO=2026
DIGI_FS_BATCH_SIZE=1000

# Telegram bot worker
TELEGRAM_BOT_TOKEN=change_me_telegram_token
TELEGRAM_ALLOWED_CHAT_IDS=change_me_chat_id
TELEGRAM_ALLOW_ALL=0
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_SLEEP_ON_ERROR=5
TELEGRAM_MAX_SLEEP_ON_ERROR=60
TELEGRAM_JOB_LOCK=/var/tmp/telegram_refresh.lock
TELEGRAM_WORKER_LOG=/var/tmp/telegram_worker.log
TELEGRAM_REFRESH_SCRIPT=scripts/refresh_sftp_mirror.sh
TELEGRAM_REFRESH_CONFIRM_CODE=change_me_confirmation_code

# Rust PDF unification helper
HE1_UNIFICAR_PDFS_BIN=he1-unificar-pdfs
HE1_UNIFICAR_PDFS_TIMEOUT=900
HE1_UNIFICAR_PDFS_DRYRUN_LIMIT=120

# SFTP monthly export GUI / helper
SFTP_EXPORT_HOST=128.127.51.34
SFTP_EXPORT_PORT=2223
SFTP_EXPORT_USER=HE1
SFTP_EXPORT_REMOTE_BASE=/home/HE1/exportaciones
SFTP_EXPORT_PASSWORD=
SFTP_EXPORT_KEY_PATH=
SFTP_EXPORT_PROFILE=






# FastAPI login (signed session cookie)
# Set a long random string (do not commit real secrets)
FASTAPI_SESSION_SECRET=change_me_session_secret

# FastAPI login debug (temporary)
# If set to 1/true, the login page shows a technical error block on failures.
FASTAPI_AUTH_DEBUG=0

# Upload audit (SQLite)
# Default (if unset): <DIGI_BASE_DIR>/_audit/uploads_audit.sqlite
UPLOADS_AUDIT_DB=

# Isolated optimized mass-upload pilot (disabled until acceptance tests pass)
MASS_UPLOAD_OPTIMIZED_ENABLED=0
MASS_UPLOAD_OPTIMIZED_USERS=CHRISTIAN_RUIZ
MASS_UPLOAD_QUEUE_DB=
MASS_UPLOAD_CPU_PER_JOB=1
MASS_UPLOAD_MEMORY_MAX=2G
MASS_UPLOAD_MAX_CONCURRENT=3
MASS_UPLOAD_WORKER_POLL_SECONDS=5
MASS_UPLOAD_STALE_AFTER_SECONDS=900
MASS_UPLOAD_OPTIMIZED_MAX_UPLOAD_BYTES=2147483648
MASS_UPLOAD_OPTIMIZED_UPLOAD_DIR=
# Keep empty until the processor is accepted in a controlled test.
MASS_UPLOAD_PROCESSOR_COMMAND=
MASS_UPLOAD_OPTIMIZED_ORACLE_GATES=1
MASS_UPLOAD_OPTIMIZED_MAX_EXPANDED_BYTES=21474836480
# Respaldo del PDF anterior cuando el piloto reemplaza el mismo nombre.
MASS_UPLOAD_OPTIMIZED_BACKUP_DIR=

# Job control from /monitor/jobs
# If your app user cannot run systemctl directly, enable sudo mode.
# SECURITY: this stores sudo password in plain text; prefer sudoers NOPASSWD for scoped commands.
JOB_CONTROL_USE_SUDO=0
JOB_CONTROL_SUDO_PASSWORD=
