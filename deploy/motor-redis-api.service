[Unit]
Description=Consulta DIGITALIZACION API
After=redis-server.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data_nuevo/motor_redis
Environment="JAVA_TOOL_OPTIONS=-Doracle.jdbc.timezoneAsRegion=false -Duser.timezone=UTC"
Environment="ORACLE_JDBC_JAR=/data_nuevo/motor_redis/jdbc/ojdbc8 copy.jar"
ExecStart=/opt/digitalizacion_he1/vevdigi/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=5
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=default.target
